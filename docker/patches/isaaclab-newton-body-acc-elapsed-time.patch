@@ -583,6 +583,35 @@ def test_initialization_floating_base(sim, num_articulations, device, add_ground
         articulation.update(sim.cfg.dt)
-
-
+
+
+@pytest.mark.parametrize("num_articulations", [1])
+@pytest.mark.parametrize("device", ["cuda:0"])
+@pytest.mark.parametrize("articulation_type", ["humanoid"])
+def test_body_com_acc_uses_elapsed_update_time(sim, num_articulations, device, articulation_type):
+    """Body acceleration must use elapsed data time when several physics steps pass between reads."""
+    articulation_cfg = generate_articulation_cfg(articulation_type=articulation_type, stiffness=0.0, damping=0.0)
+    articulation, _ = generate_articulation(articulation_cfg, num_articulations, device=device)
+    sim.reset()
+
+    # Prime the finite-difference history at the initial state.
+    previous_velocity = articulation.data.body_com_vel_w.torch.clone()
+    _ = articulation.data.body_com_acc_w.torch
+
+    num_lazy_steps = 4
+    for _ in range(num_lazy_steps):
+        sim.step()
+    elapsed_time = sim.cfg.dt * num_lazy_steps
+    articulation.update(elapsed_time)
+
+    current_velocity = articulation.data.body_com_vel_w.torch.clone()
+    expected_acceleration = (current_velocity - previous_velocity) / elapsed_time
+    torch.testing.assert_close(
+        articulation.data.body_com_acc_w.torch,
+        expected_acceleration,
+        atol=1.0e-4,
+        rtol=1.0e-4,
+    )
+
+
 @pytest.mark.parametrize("num_articulations", [1, 2])
 @pytest.mark.parametrize("device", ["cuda:0", "cpu"])
 @pytest.mark.parametrize("articulation_type", ["panda"])
