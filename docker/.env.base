###
# General settings
###

# Accept the NVIDIA Omniverse EULA by default
ACCEPT_EULA=Y
# NVIDIA Isaac Sim base image
ISAACSIM_BASE_IMAGE=nvcr.io/nvidia/isaac-sim
# NVIDIA Isaac Sim version required by Isaac Lab 3.0
ISAACSIM_VERSION=6.0.1
# Upstream URDF converter release containing the principal inertia-axis fix.
URDF_USD_CONVERTER_REF=v0.3.0
NEWTON_USD_SCHEMAS_VERSION=0.4.0
# Derived from the default path in the NVIDIA provided Isaac Sim container
DOCKER_ISAACSIM_ROOT_PATH=/isaac-sim
# The Isaac Lab path in the container (from third_party submodule)
DOCKER_ISAACLAB_PATH=/workspace/cyclo_lab/third_party/IsaacLab
# The Cyclo Lab path in the container
DOCKER_CYCLOLAB_PATH=/workspace/cyclo_lab
# Docker user directory - by default this is the root user's home directory
DOCKER_USER_HOME=/root
# Keep this Newton branch isolated from an existing Cyclo Lab container.
DOCKER_NAME_SUFFIX="-newton"
# Compose otherwise derives the same project name ("docker") for both checkouts.
COMPOSE_PROJECT_NAME="cyclo_lab_newton"
